# Provider Aliaddo (API Facturación Electrónica)

# Base URL de la API (opcional)
ALIADDO_BASE_URL=https://isv.aliaddo.net/api/v1/public/documents

# API Key (obligatoria)
ALIADDO_X_API_KEY=

# Secrets para guardar integraciones por emisor (DOCTOR/CLINIC) cifradas en DB.
# Debe ser una llave de 32 bytes en base64 (AES-256-GCM).
# Ejemplo (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
INVOICING_INTEGRATION_SECRETS_KEY_BASE64=

# Por defecto SIEMPRE usa modo pruebas.
# Para habilitación o producción, configura:
# - `ALIADDO_MODE=habilitation` o `ALIADDO_MODE=production`
ALIADDO_MODE=test

# Compatibilidad: también puedes usar flags booleanos (no combinar entre sí).
ALIADDO_HABILITATION=false
ALIADDO_PROD=false

# Timeout en ms (opcional)
ALIADDO_TIMEOUT_MS=15000

# Storage (MinIO/S3) para cachear PDF/XML
S3_BUCKET_PRIVATE=invoicing-private
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Ops (jobs de reintentos/cacheo)
INVOICING_OPS_ENABLED=false
INVOICING_RETRY_MAX_ATTEMPTS=7
INVOICING_RETRY_BASE_DELAY_SECONDS=20
INVOICING_CACHE_FILES_ENABLED=true

# CSV import (validación estricta opcional del payload convertido)
INVOICING_IMPORT_VALIDATE_STRICT=false

# RabbitMQ (opcional): para notificar cuando la integración queda ENABLED
RABBITMQ_URL=
